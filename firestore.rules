rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasMidClearance() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['moderator', 'admin'];
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function keepsRole() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        || request.resource.data.role == resource.data.get('role', 'user');
    }

    function roleFieldsOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'clearanceHold', 'updatedAt', 'touchCount', 'touchDay']);
    }

    function editQuotaOn() {
      return exists(/databases/$(database)/documents/settings/controls)
        && get(/databases/$(database)/documents/settings/controls).data.editQuota == true;
    }

    function keepsEditQuota() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editCount', 'editDay']);
    }

    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function taipeiDay() {
      let shifted = request.time + duration.value(8, 'h');
      return string(shifted.year()) + '-' + twoDigits(shifted.month()) + '-' + twoDigits(shifted.day());
    }

    function quotaStep() {
      let count = resource.data.get('editCount', 0);
      let next = request.resource.data.editCount;
      return (count < 5
          && next == count + 1
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['editDay']))
        || (count >= 5
          && next == count
          && request.resource.data.editDay == taipeiDay()
          && resource.data.get('editDay', '') != taipeiDay());
    }

    function actor() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userPaced() {
      return request.resource.data.updatedAt == request.time
        && (
          !resource.data.keys().hasAny(['updatedAt'])
          || resource.data.updatedAt < request.time - duration.value(2, 's')
        );
    }

    function quotaFieldsHeld() {
      return request.resource.data.get('opCount', 0) == resource.data.get('opCount', 0)
        && request.resource.data.get('opDay', '') == resource.data.get('opDay', '')
        && request.resource.data.get('pendingCharacterId', '') == resource.data.get('pendingCharacterId', '')
        && request.resource.data.get('pendingBind', '') == resource.data.get('pendingBind', '')
        && request.resource.data.get('reservedAt', timestamp.date(2000, 1, 1)) == resource.data.get('reservedAt', timestamp.date(2000, 1, 1));
    }

    function quotaStepUser() {
      return request.resource.data.pendingCharacterId is string
        && request.resource.data.pendingCharacterId.size() >= 16
        && request.resource.data.reservedAt == request.time
        && request.resource.data.opDay == taipeiDay()
        && request.resource.data.opCount is int
        && request.resource.data.opCount > 0
        && request.resource.data.opCount <= 200
        && request.resource.data.opCount == (
          resource.data.get('opDay', '') == taipeiDay()
            ? resource.data.get('opCount', 0) + 1
            : 1
        )
        && (
          request.resource.data.get('pendingBind', '') == resource.data.get('pendingBind', '')
          || (
            request.resource.data.pendingBind is string
            && request.resource.data.pendingBind.matches('^[A-Z0-9]{4}-[A-Z0-9]{4}$')
            && request.resource.data.pendingBind != resource.data.get('pendingBind', '')
          )
        );
    }

    function touchStep() {
      return request.resource.data.touchDay == taipeiDay()
        && request.resource.data.touchCount is int
        && request.resource.data.touchCount > 0
        && request.resource.data.touchCount <= 200
        && request.resource.data.touchCount == (
          resource.data.get('touchDay', '') == taipeiDay()
            ? resource.data.get('touchCount', 0) + 1
            : 1
        );
    }

    function reservedFor(charId) {
      return actor().pendingCharacterId == charId
        && actor().reservedAt is timestamp
        && actor().reservedAt > request.time - duration.value(45, 's')
        && actor().opDay == taipeiDay()
        && actor().opCount is int
        && actor().opCount > 0
        && actor().opCount <= 200
        && (
          !resource.data.keys().hasAny(['updatedAt'])
          || resource.data.updatedAt < actor().reservedAt
        );
    }

    function fillEmptyFileNo() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fileNo'])
        && resource.data.get('fileNo', '') == ''
        && request.resource.data.fileNo is string
        && request.resource.data.fileNo.matches('^[0-9]{3}$');
    }

    function probeFields() {
      return request.resource.data.keys().hasOnly(['text', 'createdAt', 'ephemeral'])
        && request.resource.data.ephemeral == true
        && request.resource.data.text == '測試123456789'
        && request.resource.data.createdAt == request.time;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role in ['user', 'low'];
      allow update: if signedIn() && userPaced() && touchStep() && (quotaFieldsHeld() || quotaStepUser()) && (
        (request.auth.uid == userId
          && request.resource.data.role in ['user', 'low', 'moderator', 'admin']
          && (keepsRole() || hasMidClearance() || resource.data.get('role', 'user') in ['user', 'low']))
        || (isAdmin()
          && roleFieldsOnly()
          && resource.data.role == 'moderator'
          && request.resource.data.role in ['user', 'low'])
        || (hasMidClearance()
          && roleFieldsOnly()
          && resource.data.get('role', 'user') == 'user'
          && request.resource.data.role == 'low')
        || (hasMidClearance()
          && roleFieldsOnly()
          && resource.data.role == 'low'
          && request.resource.data.role == 'user')
      );
      allow delete: if false;
    }

    match /characters/{charId} {
      allow read: if signedIn();
      allow create: if hasMidClearance()
        && charId == actor().pendingCharacterId
        && actor().reservedAt > request.time - duration.value(45, 's')
        && request.resource.data.status == 'unassigned'
        && request.resource.data.ownerUid == null
        && request.resource.data.uid is string
        && request.resource.data.bindCode is string
        && request.resource.data.fileNo is string
        && request.resource.data.name is string
        && request.resource.data.faction in ['調查員', '異常', '民眾', '議會'];
      allow update: if (hasMidClearance() && (reservedFor(charId) || fillEmptyFileNo()))
        || (signedIn()
            && resource.data.status == 'unassigned'
            && request.resource.data.status == 'bound'
            && request.resource.data.ownerUid == request.auth.uid
            && request.resource.data.bindCode == resource.data.bindCode
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.fileNo == resource.data.fileNo)
        || (signedIn()
            && resource.data.status == 'bound'
            && resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == resource.data.ownerUid
            && request.resource.data.bindCode == resource.data.bindCode
            && request.resource.data.uid == resource.data.uid
            && request.resource.data.fileNo == resource.data.fileNo
            && request.resource.data.faction == resource.data.faction
            && request.resource.data.status == 'bound'
            && reservedFor(charId)
            && ((!editQuotaOn() && keepsEditQuota()) || (editQuotaOn() && quotaStep())));
      allow delete: if hasMidClearance();
    }

    match /binds/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if hasMidClearance()
        && code == actor().pendingBind
        && request.resource.data.characterId == actor().pendingCharacterId
        && actor().reservedAt > request.time - duration.value(45, 's')
        && request.resource.data.characterId is string
        && request.resource.data.faction in ['調查員', '異常', '民眾', '議會'];
      allow delete: if hasMidClearance();
      allow update: if false;
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if (
        hasMidClearance()
        && id == 'probe-' + request.auth.uid
        && probeFields()
      ) || (
        signedIn()
        && request.resource.data.keys().hasOnly(['text', 'createdAt', 'characterId', 'faction', 'fileNo', 'characterName'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() < 80
        && request.resource.data.faction in ['調查員', '異常', '民眾', '議會']
        && request.resource.data.fileNo is string
        && request.resource.data.fileNo.size() < 20
        && request.resource.data.characterName is string
        && request.resource.data.characterName.size() > 0
        && request.resource.data.characterName.size() < 40
        && request.resource.data.createdAt == request.time
        && id == request.resource.data.characterId
        && request.resource.data.characterId is string
        && exists(/databases/$(database)/documents/characters/$(request.resource.data.characterId))
        && get(/databases/$(database)/documents/characters/$(request.resource.data.characterId)).data.ownerUid == request.auth.uid
      );
      allow update: if hasMidClearance()
        && id == 'probe-' + request.auth.uid
        && probeFields()
        && resource.data.createdAt < request.time - duration.value(20, 's');
      allow delete: if hasMidClearance()
        && (
          !id.matches('^probe-.+')
          || resource.data.createdAt < request.time - duration.value(20, 's')
        );
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && id == 'controls'
        && request.resource.data.keys().hasOnly(['rosterSnapshot', 'editQuota', 'updatedAt'])
        && request.resource.data.rosterSnapshot is bool
        && request.resource.data.editQuota is bool
        && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && id == 'controls'
        && request.resource.data.keys().hasOnly(['rosterSnapshot', 'editQuota', 'updatedAt'])
        && request.resource.data.rosterSnapshot is bool
        && request.resource.data.editQuota is bool
        && request.resource.data.updatedAt == request.time
        && resource.data.get('updatedAt', timestamp.date(2000, 1, 1)) < request.time - duration.value(2, 's');
      allow delete: if false;
    }

    match /snapshots/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (
        (id == 'rosterLock'
          && request.resource.data.keys().hasOnly(['until'])
          && request.resource.data.until is timestamp
          && request.resource.data.until > request.time
          && request.resource.data.until < request.time + duration.value(2, 'm'))
        || (id == 'roster'
          && request.resource.data.keys().hasOnly(['cards', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 200)
      );
      allow update: if signedIn() && (
        (id == 'rosterLock'
          && resource.data.until <= request.time
          && request.resource.data.keys().hasOnly(['until'])
          && request.resource.data.until is timestamp
          && request.resource.data.until > request.time
          && request.resource.data.until < request.time + duration.value(2, 'm'))
        || (id == 'roster'
          && (!resource.data.keys().hasAny(['updatedAt']) || resource.data.updatedAt < request.time - duration.value(8, 'm'))
          && request.resource.data.keys().hasOnly(['cards', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && request.resource.data.cards is list
          && request.resource.data.cards.size() <= 200)
      );
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read, write: if false;
    }
  }
}
